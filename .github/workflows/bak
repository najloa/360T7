
    - name: Initialization environment
      run: |
        sudo apt update -y
        sudo apt full-upgrade -y
        sudo apt install -y ack antlr3 asciidoc autoconf automake autopoint binutils bison build-essential \
          bzip2 ccache clang cmake cpio curl device-tree-compiler ecj fastjar flex gawk gettext gcc-multilib \
          g++-multilib git gnutls-dev gperf haveged help2man intltool lib32gcc-s1 libc6-dev-i386 libelf-dev \
          libglib2.0-dev libgmp3-dev libltdl-dev libmpc-dev libmpfr-dev libncurses-dev libpython3-dev \
          libreadline-dev libssl-dev libtool libyaml-dev libz-dev lld llvm lrzsz mkisofs msmtp nano \
          ninja-build p7zip p7zip-full patch pkgconf python3 python3-pip python3-ply python3-docutils \
          python3-pyelftools qemu-utils re2c rsync scons squashfs-tools subversion swig texinfo uglifyjs \
          upx-ucl unzip vim wget xmlto xxd zlib1g-dev zstd

        
        # 1. 替换版本号为日期变量
        sed -i 's/^PKG_VERSION:=.*/PKG_VERSION:=$(shell date +%Y.%m.%d)/' feeds/packages/net/smartdns/Makefile
        # 2. 删除源码压缩包定义
        sed -i '/^PKG_SOURCE:=/d' feeds/packages/net/smartdns/Makefile
        # 3. 删除原下载地址
        sed -i '/^PKG_SOURCE_URL:=/d' feeds/packages/net/smartdns/Makefile
        # 4. 删除安全校验 hash
        sed -i '/^PKG_HASH:=/d' feeds/packages/net/smartdns/Makefile
        # 5. 删除原构建目录定义
        sed -i '/^PKG_BUILD_DIR:=/d' feeds/packages/net/smartdns/Makefile
        # 6. 插入 git 下载配置（在 PKG_RELEASE 后插入）
        sed -i '/^PKG_RELEASE:=/a \
        \
        PKG_SOURCE_PROTO:=git\
        PKG_SOURCE_URL:=https://github.com/pymumu/smartdns.git\
        PKG_SOURCE_VERSION:=HEAD\
        PKG_SOURCE_SUBDIR:=$(PKG_NAME)-git\
        PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_SOURCE_SUBDIR)\
        ' feeds/packages/net/smartdns/Makefile

        sed -i 's|$(INSTALL_CONF) $(CURDIR)/conf/custom.conf $(1)/etc/smartdns/custom.conf|$(INSTALL_CONF) $(PKG_BUILD_DIR)/package/openwrt/custom.conf $(1)/etc/smartdns/custom.conf|' feeds/packages/net/smartdns/Makefile
        sed -i 's|$(INSTALL_CONF) $(CURDIR)/conf/smartdns.conf $(1)/etc/config/smartdns|$(INSTALL_CONF) $(PKG_BUILD_DIR)/package/openwrt/files/etc/config/smartdns $(1)/etc/config/smartdns|' feeds/packages/net/smartdns/Makefile
        sed -i 's|DEPENDS:=+libpthread +libopenssl|DEPENDS:=+libpthread +libopenssl +libatomic|' feeds/packages/net/smartdns/Makefile

        rm -rf feeds/packages/net/smartdns/conf

        rm -rf feeds/luci/applications/luci-app-smartdns
        git clone -b master https://github.com/immortalwrt/luci.git tmp_smartdns2
        \cp -rf tmp_smartdns2/applications/luci-app-smartdns/ feeds/luci/applications/luci-app-smartdns/
        # 版本 https://github.com/immortalwrt/luci/blob/openwrt-21.02/applications/luci-app-smartdns/Makefile
        sed -i '/^LUCI_DEPENDS:=+smartdns/,/include \.\.\/\.\.\/luci.mk/c\
        LUCI_DEPENDS:=+smartdns\
        LUCI_PKGARCH:=all\
        \
        include ../../luci.mk' feeds/luci/applications/luci-app-smartdns/Makefile
        rm -rf tmp_smartdns2

    - name: Delete releases and workflows runs
      uses: ophub/delete-releases-workflows@main
      with:
        delete_releases: false
        releases_keep_latest: 0
        delete_workflows: true
        workflows_keep_day: 0
        gh_token: ${{ secrets.GITHUB_TOKEN }}
