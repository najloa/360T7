name: 360T7 固件构建测试

on:
  workflow_dispatch:

permissions:
  contents: write

env:
  TZ: Asia/Shanghai

jobs:
  build:
    runs-on: ubuntu-22.04

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Initialization environment
        env:
          DEBIAN_FRONTEND: noninteractive
        run: |
          sudo apt update
          sudo apt install -y \
            build-essential clang flex bison g++ gawk \
            gcc-multilib g++-multilib gettext git \
            libncurses-dev libssl-dev libelf-dev \
            python3-distutils python3-setuptools \
            rsync swig unzip zlib1g-dev file wget \
            python3 python3-dev
          sudo timedatectl set-timezone "$TZ"

      - name: Clone OpenWrt
        run: |
          git clone --depth 1 --branch openwrt-25.12 \
            https://git.openwrt.org/openwrt/openwrt.git openwrt

      - name: Clone MediaTek feeds
        run: |
          git clone --depth 1 --branch main \
            https://github.com/mediatek/mtk-openwrt-feeds.git

      - name: Prepare MediaTek SDK
        run: |
          cd openwrt
          bash ../mtk-openwrt-feeds/autobuild/unified/autobuild.sh \
            filogic prepare

      - name: Load minimal configuration
        run: |
          cd openwrt
          cat > .config << 'EOF'
          CONFIG_TARGET_mediatek=y
          CONFIG_TARGET_mediatek_filogic=y
          CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y
          EOF

      - name: Configure firmware
        run: |
          cd openwrt
          make defconfig

      - name: Download package sources
        run: |
          cd openwrt
          make download -j$(nproc)

      - name: Compile firmware
        run: |
          cd openwrt
          make -j$(nproc) V=s

      - name: Prepare firmware path
        run: |
          echo "FIRMWARE=$GITHUB_WORKSPACE/openwrt/bin/targets/mediatek/filogic" >> "$GITHUB_ENV"

      - name: Generate release information
        id: release
        run: |
          echo "date=$(date +'%Y%m%d')" >> "$GITHUB_OUTPUT"
          echo "tag=360t7-test-$(date +'%Y%m%d')-${GITHUB_RUN_NUMBER}" >> "$GITHUB_OUTPUT"

      - name: Upload firmware to release
        uses: softprops/action-gh-release@v3
        with:
          tag_name: ${{ steps.release.outputs.tag }}
          name: 360T7 OpenWrt 25.12 Test ${{ steps.release.outputs.date }}
          files: |
            ${{ env.FIRMWARE }}/*.itb
            ${{ env.FIRMWARE }}/*.fip
            ${{ env.FIRMWARE }}/*.bin
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
